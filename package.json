{
  "name": "5g-rca-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted observability and root cause analysis for synthetic 5G Core logs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "setup": "node scripts/dev.mjs --setup-only",
    "build": "npm --prefix frontend run build",
    "test": "node scripts/test.mjs",
    "data:generate": "python scripts/generate_synthetic_data.py",
    "dev:frontend": "npm --prefix frontend run dev -- --hostname 127.0.0.1",
    "dev:backend": "node scripts/dev.mjs --backend-only"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
