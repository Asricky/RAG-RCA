{
  "name": "5g-rca-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted observability and root cause analysis for synthetic 5G Core logs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "setup": "node scripts/dev.mjs --setup-only",
    "build": "npm --prefix frontend run build",
    "test": "node scripts/test.mjs",
    "data:generate": "python scripts/generate_synthetic_data.py",
    "data:validate": "python scripts/validate_demo_data.py",
    "dev:frontend": "npm --prefix frontend run dev -- --hostname 127.0.0.1",
    "dev:backend": "node scripts/dev.mjs --backend-only"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asricky/RAG-RCA.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Asricky/RAG-RCA/issues"
  },
  "homepage": "https://github.com/Asricky/RAG-RCA#readme",
  "directories": {
    "doc": "docs"
  }
}
