# Optional configuration read by `npm run dev`.
# Copy this file to .env.local. It is ignored by Git.

DATABASE_URL=sqlite:///./rca_copilot.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=5g-logs-st-v1
OPENSEARCH_KNOWLEDGE_INDEX=5g-knowledge-v1
OPENSEARCH_TIMEOUT_SECONDS=30

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
LLM_ALLOW_MOCK_FALLBACK=true

# Optional paid provider. It is not required for the local demo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_TIMEOUT_SECONDS=120

# Use `raw` only when local private CSV files exist under data/kpi/raw/.
KPI_SOURCE=demo
KPI_RAW_DIR=./data/kpi/raw

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
INDEX_BATCH_SIZE=256
INDEX_MAX_RETRIES=3
INDEX_PROGRESS_EVERY_BATCHES=10
MAX_CONCURRENT_INDEX_JOBS=1
MAX_UPLOAD_BYTES=262144000
MAX_DATASET_RECORDS=1000000
LOG_MEMORY_LIMIT=100000
DEFAULT_ALPHA=0.5
DEFAULT_TOP_K=10
KNOWLEDGE_TOP_K=3
