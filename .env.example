APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/rca_copilot
JWT_SECRET=change-this-in-production
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=5g-logs
EMBEDDING_MODEL=feature-hashing-v1
EMBEDDING_DIMENSION=384
DEFAULT_ALPHA=0.5
DEFAULT_TOP_K=10
DEFAULT_TIME_WINDOW_BEFORE=5
DEFAULT_TIME_WINDOW_AFTER=5
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
LIVE_LOG_POLL_SECONDS=2
SEED_DEMO_USERS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=
API_URL=http://backend:8000
