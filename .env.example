APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/rca_copilot
JWT_SECRET=change-this-in-production
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=5g-logs-st-v1
OPENSEARCH_KNOWLEDGE_INDEX=5g-knowledge-v1
OPENSEARCH_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
DEFAULT_ALPHA=0.5
DEFAULT_TOP_K=10
KNOWLEDGE_TOP_K=3
DEFAULT_TIME_WINDOW_BEFORE=5
DEFAULT_TIME_WINDOW_AFTER=5
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
LLM_ALLOW_MOCK_FALLBACK=true
# Optional paid provider. It is not required for normal operation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_TIMEOUT_SECONDS=120
KPI_SOURCE=demo
KPI_RAW_DIR=/data/kpi/raw
DOMAIN_CONFIG_DIR=/config/domain
KNOWLEDGE_DEMO_FILE=/data/demo/sample_knowledge.json
INDEX_BATCH_SIZE=256
INDEX_MAX_RETRIES=3
INDEX_PROGRESS_EVERY_BATCHES=10
MAX_CONCURRENT_INDEX_JOBS=1
MAX_UPLOAD_BYTES=262144000
MAX_DATASET_RECORDS=1000000
LOG_MEMORY_LIMIT=100000
LIVE_LOG_POLL_SECONDS=2
SEED_DEMO_USERS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=
API_URL=http://backend:8000
